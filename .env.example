PAYMENT_MODE=demo
PORT=5174
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5174

# ==============================================================================
# Solana RPC Configuration & API Key:
# Where to get a free API Key:
# 1. Register for free at Helius: https://helius.dev (or QuickNode: https://quicknode.com)
# 2. In your dashboard, create a new Solana Devnet project.
# 3. Copy your RPC URL and paste it below:
#    Example: SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# ==============================================================================
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Devnet only: JSON array of 64 secret-key bytes; server only. Never use a real-money wallet.
TREASURY_SECRET_KEY=

# At least 32 random characters. Required only in Devnet mode.
MERCHANT_TOKEN=

