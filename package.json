    "react-dom": "19.3.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "overrides": { "jayson": { "uuid": "^11.1.1" } },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
